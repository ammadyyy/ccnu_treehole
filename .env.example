# 回声洞环境变量示例。复制为 .env 并按需修改。

# 运行模式：demo / dev / prod
APP_ENV=demo

# 站点访问地址（用于生成分享链接、二维码等；演示阶段为校园网 IP+端口）
APP_URL=http://127.0.0.1:8000

# 监听地址与端口
HOST=0.0.0.0
PORT=8000

# 数据目录（数据库与图片的父目录）
DATA_DIR=./data

# SQLite 数据库文件路径（相对或绝对）
DATABASE_PATH=./data/echohole.db

# 图片上传目录
UPLOAD_DIR=./data/uploads

# Cookie Secure 标志：接入 HTTPS 后置为 true，本机 HTTP 演示为 false
COOKIE_SECURE=false

# 会话签名密钥（生产必须改为随机值）
SECRET_KEY=change-me-to-a-random-string
